#!/bin/sh
# session-info - the plugin's SessionStart entry, two verbs, one registration
# each: `title` sets the session title to the short session id, `context`
# injects the session's facts (id, working directory, source, transcript).
# It runs sessiontools.session_info from this plugin's own src/ and stays
# SILENT whatever goes wrong. A hook must never be the reason a session breaks.
#
#   DEFAULT OFF. Each verb has its own switch, checked before python starts:
#   SESSIONTOOLS_HOOK_TITLE=on          the title verb runs (also 1/true/yes)
#   SESSIONTOOLS_HOOK_SESSION_INFO=on   the context verb runs (also 1/true/yes)
#   switch unset, or anything else      exit 0 - python never starts
#   an unknown verb                     exit 0
#   no pick-python.sh beside it         exit 0
#   no python at all                    exit 0
#   python older than 3.11              exit 0 (the -c guard below)
#   python crashes, or anything         exit 0, stderr to /dev/null
#
# The python is the one the other hooks run: `pick`, from pick-python.sh
# beside this file, sourced with `.` (no fork) and only once a switch is on.
#
# No `exec python`: the `|| exit 0` has to run after python returns. stdin
# passes through. The shim's own stderr goes to /dev/null too.
exec 2>/dev/null
case "${1:-}" in
  title) on=${SESSIONTOOLS_HOOK_TITLE:-} ;;
  context) on=${SESSIONTOOLS_HOOK_SESSION_INFO:-} ;;
  *) exit 0 ;;
esac
case "$on" in
  [Oo][Nn] | 1 | [Tt][Rr][Uu][Ee] | [Yy][Ee][Ss]) ;;
  *) exit 0 ;;
esac
# This file's dir, by builtins (no `$(dirname)` fork). A bare `$0` is ".".
case "$0" in */*) here=${0%/*} ;; *) here=. ;; esac
[ -r "$here/pick-python.sh" ] || exit 0   # `.` of a missing file exits 1
py=
# shellcheck disable=SC1091 # linted on its own
. "$here/pick-python.sh"
pick || exit 0
"$py" -I -c 'import sys
if sys.version_info < (3, 11):
    sys.exit(0)
sys.path.insert(0, sys.argv[1])
from sessiontools.session_info import main
sys.exit(main(sys.argv[2:]))' "$here/../src" "$1" || exit 0
