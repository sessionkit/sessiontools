#!/bin/sh
# md-lint - the plugin's PostToolUse entry (matcher Write|Edit|MultiEdit):
# run sessiontools.md_lint on the hook's JSON, from this plugin's own src/,
# and stay SILENT whatever goes wrong. It answers, it never blocks: a hook
# must never be the reason a turn breaks.
#
#   SESSIONTOOLS_HOOK_MD_LINT off/0/false/no   exit 0 (any case); python never starts
#   no CLAUDE_CODE_SESSION_ID, or no session dir   exit 0: BIRTH-ONLY, as settle-hook;
#                                    a session `session start` did not launch is silent
#   a payload with no `.md"` in it   exit 0 before python (any case); python
#                                    still makes the exact decision
#   no pick-python.sh beside it      exit 0
#   no python at all                 exit 0
#   python older than 3.11           exit 0 (the -c guard below)
#   python crashes, or anything      exit 0, stderr to /dev/null
#
# ON BY DEFAULT for a seat `session start` launched: anything but the off
# words, unset included, is on.
#
# The python is the one the other hooks run: `pick`, from pick-python.sh
# beside this file, sourced with `.` (no fork). No `exec python`: the
# `|| exit 0` has to run after python returns. The payload, read once for
# the pre-filter, is handed to python with printf (never echo, which may
# read a backslash). The shim's OWN stderr goes to /dev/null too: when python
# is killed, sh itself reports it on stderr, and a hook's stderr is shown.
exec 2>/dev/null
case "${SESSIONTOOLS_HOOK_MD_LINT:-}" in
  [Oo][Ff][Ff] | 0 | [Ff][Aa][Ll][Ss][Ee] | [Nn][Oo]) exit 0 ;;
esac
# This file's dir, by builtins (no `$(dirname)` fork). A bare `$0` is ".".
case "$0" in */*) here=${0%/*} ;; *) here=. ;; esac
[ -r "$here/session-dir.sh" ] || exit 0   # `.` of a missing file exits 1
# shellcheck disable=SC1091 # linted on its own
. "$here/session-dir.sh"
session_dir || exit 0
payload=$(cat) || exit 0
case "$payload" in
  *.[Mm][Dd]\"*) ;;
  *) exit 0 ;;
esac
[ -r "$here/pick-python.sh" ] || exit 0   # `.` of a missing file exits 1
py=
# shellcheck disable=SC1091 # linted on its own
. "$here/pick-python.sh"
pick || exit 0
printf '%s' "$payload" | "$py" -I -c 'import sys
if sys.version_info < (3, 11):
    sys.exit(0)
sys.path.insert(0, sys.argv[1])
from sessiontools.md_lint import main
sys.exit(main())' "$here/../src" || exit 0
exit 0
